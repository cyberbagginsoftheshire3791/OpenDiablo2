{
  "permissions": {
    "deny": [
      "Bash(go get -u:*)",
      "Edit(**/*.mpq)",
      "Edit(**/*.dc6)",
      "Edit(**/*.dcc)",
      "Edit(**/*.ds1)",
      "Edit(**/*.dt1)",
      "Edit(**/*.cof)",
      "Edit(**/*.pl2)",
      "Edit(**/*.tbl)",
      "Edit(**/*.d2)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go run ./tools/strigoihook session-start",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go run ./tools/strigoihook pre-write",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go run ./tools/strigoihook pre-bash",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go run ./tools/strigoihook post-edit",
            "timeout": 420
          }
        ]
      }
    ]
  }
}
